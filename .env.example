# Works without a model or API key. Never commit a real .env file.
DATABASE_URL=sqlite:///./data/supportlens.db
ANSWER_PROVIDER=extractive
# Run python3 scripts/setup_ai.py to configure local generation and semantic search.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct
# Optional model download. First install: pip install -e '.[semantic]'
ENABLE_SEMANTIC=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SEED_DEMO=true
